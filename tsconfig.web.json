{
  "include": ["src/renderer/src/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [],
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // Off deliberately: the frozen contracts under src/shared/contracts are
    // copied verbatim and carry forward-looking imports that are not yet
    // referenced (e.g. PodStatus in event-store.ts). Neither flag is part of
    // `strict`; turning them on would require editing a frozen contract.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
