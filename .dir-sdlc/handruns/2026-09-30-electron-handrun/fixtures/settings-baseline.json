{
  "model": "claude-opus-5",
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Read(//c/oc-test/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "OC_HANDRUN": "baseline",
    "OC_MARKER": "do-not-ship"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo orcastrate-handrun-baseline"
          }
        ]
      }
    ]
  }
}
